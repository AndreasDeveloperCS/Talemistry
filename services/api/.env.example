# Talemistry API environment
NODE_ENV=development
PORT=4000

# MongoDB connection (Atlas or local)
# IMPORTANT: Add this host's public egress IP to the MongoDB Atlas
# Network Access (IP ACL) list, or the connection will time out.
#   - Current v0 sandbox egress IP whitelisted: 18.190.239.146
#   - This IP is DYNAMIC and rotates when the sandbox/host restarts.
#     Re-whitelist the new IP, or use 0.0.0.0/0 for serverless deploys.
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/evryka?retryWrites=true&w=majority&tls=true

# CORS — comma separated origins (Next.js + Angular dev servers)
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# Auth (placeholder — wire to your IdP / JWT provider)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# WebRTC TURN/STUN for interview video (client also needs these)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
