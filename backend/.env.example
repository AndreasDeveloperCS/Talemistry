# WebRTC ICE servers (sent to clients via `get-ice-servers`)
RTC_STUN_ENABLED=true
RTC_STUN_URLS=
RTC_TURN_ENABLED=true
RTC_TURN_URLS=
RTC_TURN_USERNAME=
RTC_TURN_PASSWORD=

